{
  "name": "Crypto Predictions",
  "secrets": [
    {
      "key": "EXPLORER_UPSTREAM",
      "description": "Base URL of the public block explorer the /explorer-api proxy forwards to. Defaults to the platform's hosted explorer if unset.",
      "required": false,
      "private": false,
      "default": "https://social-vibecoding.usernodelabs.org/explorer-api"
    }
  ],
  "tests": [
    {
      "name": "Registration screen loads",
      "path": "/",
      "expectSelector": "#card"
    },
    {
      "name": "Unregistered Register screen renders",
      "path": "/",
      "expectText": "Register to start trading"
    },
    {
      "name": "Health check",
      "path": "/health",
      "expectText": "ok",
      "allowConsoleErrors": true
    }
  ]
}
